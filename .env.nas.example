# Secrets stay in this untracked file or in the shared Docker secret files.
DASHSCOPE_API_KEY=
GEMINI_API_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
RECEIVER_EMAIL=

TZ=Asia/Shanghai
RUN_MODE=schedule
RUN_TIMES=13:00,22:00
RUN_ON_STARTUP=false
RUN_LOCK_PATH=/app/data/.scheduler.lock
RUN_RETRIES=3
RETRY_DELAY_SECONDS=60

MARKDOWN_EXPORT_ENABLED=true
EXPORT_TRANSCRIPT=true
EXPORT_USE_EXISTING_COURSE_DIRS=true
EXPORT_COURSE_SUBDIR=录课转写

# The NAS already has both models mounted. Set false on a fresh deployment.
SKIP_MODEL_DOWNLOAD=true
